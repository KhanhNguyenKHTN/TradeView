generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AssetCategoryCode {
  GOLD
  SAVING
  STOCK
  COIN
}

enum TransactionType {
  BUY
  SELL
}

enum PriceSource {
  MANUAL
  AUTO
}

model AssetCategory {
  id        Int               @id @default(autoincrement())
  code      AssetCategoryCode @unique
  name      String
  isEnabled Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  assets    Asset[]

  @@map("asset_categories")
}

model Asset {
  id             Int             @id @default(autoincrement())
  categoryId     Int
  symbol         String
  name           String
  unit           String
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       AssetCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions   Transaction[]
  priceSnapshots PriceSnapshot[]

  @@unique([categoryId, symbol])
  @@map("assets")
}

model Transaction {
  id            Int             @id @default(autoincrement())
  assetId       Int
  type          TransactionType
  quantity      Decimal         @db.Decimal(20, 8)
  price         Decimal         @db.Decimal(20, 8)
  fee           Decimal         @default(0) @db.Decimal(20, 8)
  executedAt    DateTime
  settledAt     DateTime?
  note          String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, executedAt])
  @@map("transactions")
}

model PriceSnapshot {
  id         Int         @id @default(autoincrement())
  assetId     Int
  price      Decimal     @db.Decimal(20, 8)
  source     PriceSource @default(MANUAL)
  capturedAt DateTime
  createdAt  DateTime    @default(now())
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, capturedAt])
  @@map("price_snapshots")
}