generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AssetCategoryCode {
  GOLD
  SAVING
  STOCK
  COIN
}

enum TransactionType {
  BUY
  SELL
}

enum PriceSource {
  MANUAL
  AUTO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model AssetCategory {
  id        Int               @id @default(autoincrement())
  code      AssetCategoryCode @unique
  name      String
  isEnabled Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  assets    Asset[]

  @@map("asset_categories")
}

model Asset {
  id             Int             @id @default(autoincrement())
  categoryId     Int
  symbol         String
  name           String
  unit           String
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       AssetCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions   Transaction[]
  priceSnapshots PriceSnapshot[]

  @@unique([categoryId, symbol])
  @@map("assets")
}

model Transaction {
  id            Int             @id @default(autoincrement())
  assetId       Int
  type          TransactionType
  quantity      Decimal         @db.Decimal(20, 8)
  price         Decimal         @db.Decimal(20, 8)
  fee           Decimal         @default(0) @db.Decimal(20, 8)
  executedAt    DateTime
  settledAt     DateTime?
  note          String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, executedAt])
  @@map("transactions")
}

model PriceSnapshot {
  id         Int         @id @default(autoincrement())
  assetId     Int
  price      Decimal     @db.Decimal(20, 8)
  source     PriceSource @default(MANUAL)
  capturedAt DateTime
  createdAt  DateTime    @default(now())
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, capturedAt])
  @@map("price_snapshots")
}

 model Task {
   id                     Int          @id @default(autoincrement())
   title                  String
   description            String       @db.Text
   note                   String?      @db.Text
   status                 TaskStatus   @default(TODO)
   priority               TaskPriority @default(MEDIUM)
   dueDate                DateTime
   owner                  String
   category               String
   isFinancialPlan        Boolean      @default(false)
   financialTargetAmount  Decimal      @default(0) @db.Decimal(20, 2)
   financialCurrentAmount Decimal      @default(0) @db.Decimal(20, 2)
   progress               Int          @default(0)
   dueReminderSentAt      DateTime?
   createdAt              DateTime     @default(now())
   updatedAt              DateTime     @updatedAt

   @@index([status, dueDate])
   @@index([isFinancialPlan])
   @@index([dueReminderSentAt, dueDate])
   @@map("tasks")
 }

model MonthlyIncome {
  id          Int      @id @default(autoincrement())
  month       String   @unique
  amount      Decimal  @db.Decimal(20, 2)
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([month])
  @@map("monthly_incomes")
}

model ExtraIncome {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(20, 2)
  title       String
  note        String?  @db.Text
  receivedAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([receivedAt])
  @@map("extra_incomes")
}

model ExpenseCategory {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  color            String?
  isEnabled        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  recurringExpenses RecurringExpense[]
  expenseEntries   ExpenseEntry[]

  @@map("expense_categories")
}

model RecurringExpense {
  id                Int               @id @default(autoincrement())
  categoryId        Int
  title             String
  amount            Decimal           @db.Decimal(20, 2)
  frequency         ExpenseFrequency
  dayOfWeek         Int?
  dayOfMonth        Int?
  monthOfYear       Int?
  startDate         DateTime
  endDate           DateTime?
  note              String?           @db.Text
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  category          ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenseEntries    ExpenseEntry[]

  @@index([categoryId, frequency, isActive])
  @@index([startDate, endDate])
  @@map("recurring_expenses")
}

model ExpenseEntry {
  id                 Int               @id @default(autoincrement())
  categoryId         Int
  recurringExpenseId Int?
  amount             Decimal           @db.Decimal(20, 2)
  title              String
  note               String?           @db.Text
  spentAt            DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  category           ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([spentAt, categoryId])
  @@index([recurringExpenseId, spentAt])
  @@map("expense_entries")
}

 model PushSubscription {
   id             Int       @id @default(autoincrement())
   endpoint       String    @db.Text
   p256dh         String    @db.Text
   auth           String    @db.Text
   expirationTime BigInt?
   userAgent      String?   @db.Text
   platform       String?
   isActive       Boolean   @default(true)
   createdAt      DateTime  @default(now())
   updatedAt      DateTime  @updatedAt
   lastUsedAt     DateTime?

   @@unique([endpoint(length: 255)])
   @@index([isActive, updatedAt])
   @@map("push_subscriptions")
 }
